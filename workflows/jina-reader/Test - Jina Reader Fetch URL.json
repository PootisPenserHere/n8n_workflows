    {
      "parameters": {
        "jsCode": "const response = $input.item.json || {};\n\nreturn {\n  json: {\n    status: response.status,\n    provider: response.provider,\n    url: response.url,\n    readerUrl: response.readerUrl,\n    fetched: response.fetched,\n    contentChars: response.contentChars || 0,\n    originalContentChars: response.originalContentChars || 0,\n    truncated: response.truncated || false,\n    // This is the preferred field downstream callers should use.\n    contentPreview: typeof response.content === 'string' ? response.content.slice(0, 1000) : '',\n    error: response.error || null,\n    retry: response.retry || null,\n    attemptsMade: response.attemptsMade ?? response.retry?.attemptsMade ?? null,\n    maxAttempts: response.maxAttempts ?? response.retry?.maxAttempts ?? null,\n    rateLimit: response.rateLimit || null,\n    fullResponse: response\n  }\n};"
      },
